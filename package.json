    "sync-upstream": "bash desktop-web/scripts/sync-upstream.sh"
  },
  "dependencies": {
    "lucide-react": "0.577.0"
  },
  "engines": {
    "node": "^22.22.0 || ^24.11.0 || >=26.0.0",
