{
  "name": "hermes-web-ui",
  "private": true,
  "description": "The Hermes desktop app as a web UI for your Hermes gateway.",
  "license": "MIT",
  "workspaces": [
    "apps/shared",
    "apps/desktop"
  ],
  "scripts": {
    "dev": "npm run dev --prefix desktop-web",
