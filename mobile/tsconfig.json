{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "types": [
      "jest",
      "node"
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@hermes/shared": [
        "../apps/shared/src/index.ts"
      ],
      "@hermes/shared/*": [
        "../apps/shared/src/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "../apps/shared/src"
  ]
}
