{
  "name": "hermes-mobile",
  "version": "0.1.0",
  "private": true,
  "description": "The Hermes mobile app, for chatting with a Hermes gateway from a phone.",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "strings": "node scripts/export-strings.mjs",
    "built-for-version": "node scripts/write-built-for-version.mjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@nanostores/react": "^2.0.1",
    "@shopify/flash-list": "^2.0.2",
    "expo": "~57.0.0",
    "expo-asset": "~57.0.0",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.0",
    "expo-dev-client": "~57.0.0",
    "expo-file-system": "~57.0.0",
    "expo-font": "~57.0.0",
    "expo-linking": "~57.0.0",
    "expo-router": "~57.0.0",
    "expo-sqlite": "~57.0.0",
    "expo-status-bar": "~57.0.0",
    "expo-system-ui": "~57.0.0",
    "nanostores": "^1.5.5",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-enriched-markdown": "^1.1.1",
    "react-native-paper": "^5.15.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-url-polyfill": "^4.0.0"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.86.3",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.19.2",
    "@types/react": "~19.2.0",
    "@types/ws": "^8.18.2",
    "babel-preset-expo": "~57.0.0",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.0",
    "react-dom": "^19.2.3",
    "test-renderer": "^1.3.0",
    "typescript": "~6.0.3",
    "ws": "^8.22.0"
  },
  "enriched-markdown": {
    "enableCodeHighlight": true,
    "enableMath": false,
    "enableVideo": false,
    "codeHighlightLanguages": [
      "bash",
      "c",
      "cpp",
      "css",
      "go",
      "html",
      "java",
      "javascript",
      "json",
      "python",
      "rust",
      "tsx",
      "typescript",
      "yaml"
    ]
  }
}
